  <diagram id="page-fanout-flow" name="2. Publish Fan-out Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="Template-Publish Fan-Out Worker — Control Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-start" value="TemplatePublishEvent&lt;br&gt;(publishId, templateId, versionId,&lt;br&gt;market, withdrawn, publishedAt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-fetch" value="Fetch page from Registry&lt;br&gt;(templateId, market, cursor, pageSize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-loop" value="For each engagement&lt;br&gt;(concurrent, bounded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-claim" value="Already claimed?&lt;br&gt;(Idempotency ledger)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="400" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-skip1" value="Skip&lt;br&gt;(already processed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="420" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-eligible" value="Eligible?&lt;br&gt;market / ordering /&lt;br&gt;declined / current" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="540" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-skip2" value="Mark SKIPPED&lt;br&gt;+ next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="570" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-permit" value="Acquire bulkhead permit&lt;br&gt;(cap in-flight downstream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="700" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-call" value="Call downstream&lt;br&gt;updatePending (~1 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="800" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-success" value="Success?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="910" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-update" value="Update Registry&lt;br&gt;+ ledger COMPLETED&lt;br&gt;+ next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="920" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-retryable" value="Retriable and&lt;br&gt;attempts left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="910" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-backoff" value="Backoff&lt;br&gt;(exponential)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="920" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-fail" value="Mark FAILED&lt;br&gt;+ failed list / DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="1070" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-end" value="Return FanoutResult&lt;br&gt;(processed, applied, skipped,&lt;br&gt;failed, blocked, failedIds)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="1080" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-note1" value="Page-by-page: commit the cursor after each page and repeat&lt;br&gt;until nextCursor is null. One slow item never aborts the publish;&lt;br&gt;failures are reported for replay." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="700" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-note2" value="The bulkhead is global per environment (or distributed).&lt;br&gt;Executor size = permits. Downstream capacity is the binding&lt;br&gt;constraint, not CPU." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1300" y="860" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-start" target="p2-fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-fetch" target="p2-loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="next engagement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-loop" target="p2-claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-claim" target="p2-skip1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-claim" target="p2-eligible">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-eligible" target="p2-skip2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-eligible" target="p2-permit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="p2-permit" target="p2-call">
